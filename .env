# Salin ke .env lalu sesuaikan. Baris kosong / diawali # diabaikan.

# Port server (default 24650)
PORT=24581
# Interface yang di-bind. 0.0.0.0 = bisa diakses dari LAN/VPS, 127.0.0.1 = hanya lokal.
BIND_HOST=0.0.0.0

# SANGAT DISARANKAN bila server bisa dijangkau dari luar: token wajib untuk semua koneksi realtime.
# Buka UI dengan  http://host:port/#token=ISI_TOKEN  (disimpan di browser, tidak dikirim ke server lewat URL).
ACCESS_TOKEN=

# Wajib bila diakses lewat domain publik (ngrok/VPS) agar thumbnail embed Discord terbaca.
PUBLIC_URL=
# Override IP yang ditampilkan di banner (opsional)
HOST=
# Origin tambahan yang boleh membuka WebSocket (pisah koma). Same-origin selalu diizinkan.
ALLOWED_ORIGIN=
# Aktifkan hanya bila di belakang reverse proxy tepercaya (membaca X-Forwarded-For)
TRUST_PROXY=false

# Webhook Discord default untuk sesi yang belum punya webhook sendiri
DISCORD_WEBHOOK_URL=
# Maksimal sesi bot
MAX_SESSIONS=6
# Versi Minecraft untuk sesi yang kolom Version-nya kosong. Kosong = deteksi otomatis dari server.
# Bila muncul banyak "PartialReadError" / inventory kosong, server lebih baru dari protokol yang dikenal
# mineflayer: isi dengan versi yang didukung server lewat ViaVersion, mis. 1.21.1
DEFAULT_MC_VERSION=1.21.1
# true = tampilkan error parsing paket protokol di konsol (default: disembunyikan)
SHOW_PROTOCOL_ERRORS=false
# Folder sessions.db & logs/ (default: folder proyek)
DATA_DIR=
DISABLE_CHAT_LOG=false
# Izinkan ping ke IP privat/LAN dari tombol Ping
ALLOW_PRIVATE_PING=false
# debug | info | warn | error | fatal | silent
LOG_LEVEL=warn
